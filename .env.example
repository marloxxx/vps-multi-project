# Stack root – setup.sh enforces /opt/stack
OPT_BASE=/opt
STACK_ROOT=/opt/stack

BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Traefik TLS: file-loaded PEM (wildcard/SAN). Routers use tls=true, no certresolver.
# ACME resolver stays in Traefik config for optional Let's Encrypt hosts only.

# Written by setup.sh after SSH port change (optional reference)
# SSH_PORT=

# Traefik dashboard (required)
# Replaced by setup.sh if unset or contains "change_me".
TRAEFIK_DASHBOARD_AUTH=admin:change_me
TRAEFIK_DASHBOARD_HOST=traefik.example.com

# ---------- Platform services ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong

REDIS_PASSWORD=change_me_redis

SEAWEEDFS_ACCESS_KEY=seaweedadmin
SEAWEEDFS_SECRET_KEY=change_me_seaweedfs

# ---------- Paths ----------
POSTGRES_DATA_DIR=/opt/volumes/postgres
REDIS_DATA_DIR=/opt/volumes/redis
SEAWEEDFS_DATA_DIR=/opt/volumes/seaweedfs
MYSQL_DATA_DIR=/opt/volumes/mysql
BACKUP_DIR=/opt/backups/postgres
# BACKUP_DIR_MYSQL=/opt/backups/mysql
# Auto-backup — Google Drive is the real safety net (local = staging only)
# stackctl auto-backup gdrive-setup
BACKUP_RCLONE_REMOTE=gdrive:vps-backups/my-server
BACKUP_REQUIRE_RCLONE=1
# BACKUP_RCLONE_MODE=copy
# BACKUP_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# BACKUP_UPLOAD_DIR=/opt/backups
# BACKUP_RCLONE_ARGS=--transfers=4 --checkers=8
# BACKUP_CRON=0 3 * * *
# BACKUP_RETENTION_DAYS=7
# BACKUP_POSTGRES_MODE=all
# BACKUP_INCLUDE_MYSQL=auto
# BACKUP_LOG=/opt/backups/auto-backup.log

# SWAP_SIZE_GB=2
# SWAP_FILE=/swapfile

# ---------- App hosts (replace example.com via setup or sed) ----------
SEAWEEDFS_ADMIN_HOST=seaweedfs.example.com
SEAWEEDFS_API_HOST=s3.example.com

# ---------- Portainer (required) ----------
PORTAINER_HOST=portainer.example.com
PORTAINER_DATA_DIR=/opt/volumes/portainer
# PORTAINER_TRAEFIK_AUTH=user:htpasswd_hash

# ---------- Optional stacks (setup.sh prompts on TTY; else set here or export) ----------
# START_SEAWEEDFS=1
# START_MONITORING=1

# ---------- Monitoring (started by setup.sh when START_MONITORING=1) ----------
GRAFANA_HOST=grafana.example.com
GRAFANA_ADMIN_PASSWORD=change_me
PROMETHEUS_DATA_DIR=/opt/volumes/prometheus
GRAFANA_DATA_DIR=/opt/volumes/grafana
# GRAFANA_TRAEFIK_AUTH=user:htpasswd_hash

# START_MONITORING=1

# Optional MySQL
# MYSQL_ROOT_PASSWORD=change_me_mysql
